# Development (Laravel Sail + PostgreSQL). Copy to .env, then: ./vendor/bin/sail artisan key:generate
# Production settings live in .env.production.example — see docs/DEPLOY.md.
APP_NAME="Boutique AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must be larger than `queue:work --timeout=180`, otherwise a slow job may be picked up twice.
DB_QUEUE_RETRY_AFTER=200

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# Sail forwards 5173 into the container — Vite on the Mac uses 5173, so keep Sail's port elsewhere.
VITE_PORT=5199

# Public sign-up for the starter-kit auth pages (dev only).
AUTH_REGISTRATION=true

# --- Try-on ---
# mock = free fake result | openai = real AI, visitor key required | auto = demo: real AI only with a visitor key
TRYON_PROVIDER=mock
TRYON_MOCK_DELAY=3
TRYON_DISK=local
# TRYON_OPENAI_MODEL=gpt-image-2.5-sunburst
# TRYON_OPENAI_INPUT_FIDELITY=
