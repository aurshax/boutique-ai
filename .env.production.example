# Production template. Never commit the real file. Most hosts (Laravel Cloud, Forge...) take these as
# environment variables in their dashboard instead of a .env file. See docs/DEPLOY.md.
APP_NAME="Boutique AI"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false                # NEVER true in production: error pages would leak config and headers
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily                # Laravel Cloud: use `stderr` so logs show up in the dashboard
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true     # HTTPS only
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=200
CACHE_STORE=database
FILESYSTEM_DISK=local

# Behind the host's load balancer / reverse proxy (correct HTTPS URLs and client IPs for rate limits).
TRUSTED_PROXIES=*

MAIL_MAILER=log

# The public site is a demo: no account pages at all (login, sign-up, settings → 404), no seeded admin.
AUTH_ENABLED=false
AUTH_REGISTRATION=false

# --- Try-on ---
# auto: free mock result by default; real AI only when the visitor enters their own OpenAI key.
TRYON_PROVIDER=auto
TRYON_MOCK_DELAY=3
# Customer photos must survive deploys/restarts: use a PRIVATE S3-compatible bucket (Laravel Cloud
# object storage, Cloudflare R2, AWS S3) configured as the `s3` disk below. `local` only on a VPS with a persistent disk.
TRYON_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
